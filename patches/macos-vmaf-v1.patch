diff --git a/script/functions.sh b/script/functions.sh
index 87c7f62..878629e 100755
--- a/script/functions.sh
+++ b/script/functions.sh
@@ -45,22 +45,39 @@ echoDurationInSections(){
 download(){
     URL=$1
     NAME=$2
-    curl -o "$NAME" -L -f "$URL"
+    if [ -z "${VMAF_SOURCE_LOCK:-}" ]; then
+        echo "VMAF_SOURCE_LOCK is required"
+        return 1
+    fi
+    EXPECTED_SHA256=$(python3 - "$VMAF_SOURCE_LOCK" "$NAME" <<'PY'
+import json
+import sys
+
+with open(sys.argv[1], encoding="utf-8") as handle:
+    files = json.load(handle)["files"]
+try:
+    print(files[sys.argv[2]])
+except KeyError:
+    print(f"unlocked build input: {sys.argv[2]}", file=sys.stderr)
+    raise SystemExit(1)
+PY
+    ) || return 1
+    curl -o "$NAME" -L -f "$URL" || return 1
+    ACTUAL_SHA256=$(shasum -a 256 "$NAME" | awk '{print $1}')
+    if [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
+        echo "SHA-256 mismatch for $NAME: expected $EXPECTED_SHA256, got $ACTUAL_SHA256"
+        rm -f "$NAME"
+        return 1
+    fi
 }

